{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spatial.local/schemas/product-profile.schema.json",
  "title": "Spatial Product Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "composition", "features", "content", "platforms", "permissions", "distribution", "support", "acceptance"],
  "properties": {
    "api_version": {"const": "spatial.product/v1"},
    "kind": {"const": "ProductProfile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "label", "tier"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"},
        "version": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "tier": {"enum": ["tier-1", "preview", "internal"]}
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ui_modules", "backend_components", "viewer_variant"],
      "properties": {
        "ui_modules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "backend_components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "viewer_variant": {"enum": ["full", "simple"]}
      }
    },
    "features": {"type": "object"},
    "content": {
      "type": "object",
      "required": ["minimum_scene_packages", "maximum_scene_packages", "required_scene_capabilities", "include_active_analysis"],
      "properties": {
        "minimum_scene_packages": {"type": "integer", "minimum": 0},
        "maximum_scene_packages": {"type": "integer", "minimum": 0},
        "required_scene_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "include_active_analysis": {"type": "boolean"}
      }
    },
    "platforms": {"type": "object"},
    "permissions": {"type": "object"},
    "distribution": {
      "type": "object",
      "required": ["modes", "default_mode"],
      "properties": {
        "modes": {"type": "array", "items": {"enum": ["connected", "split", "offline"]}},
        "planned_modes": {"type": "array", "items": {"enum": ["connected", "split", "offline"]}},
        "default_mode": {"enum": ["connected", "split", "offline"]}
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "diagnostic_bundle", "overlay_backup_restore", "state_transfer"],
      "properties": {
        "policy": {"const": "internal-product-support-v1"},
        "diagnostic_bundle": {"type": "boolean"},
        "overlay_backup_restore": {"type": "boolean"},
        "state_transfer": {"type": "boolean"}
      }
    },
    "acceptance": {"type": "object", "required": ["suite", "required"]}
  }
}
