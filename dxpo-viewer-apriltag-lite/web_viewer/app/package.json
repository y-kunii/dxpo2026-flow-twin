{
  "name": "spatial-3dgs-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "predev": "node scripts/refresh_scene_package_index.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/refresh_scene_package_index.mjs",
    "build": "tsc && node scripts/check_viewer_architecture.mjs && vite build && node scripts/check_bundle_budget.mjs dist",
    "build:app": "tsc && vite build",
    "build:apps": "tsc && vite build --mode colmap && vite build --mode apriltag-check && vite build --mode spz-import && vite build --mode scene-manager && vite build --mode project-manager && vite build --mode package-builder && vite build --mode viewer && vite build --mode field-memory && vite build --mode site-insights && vite build --mode frame-analysis",
    "test:smoke": "node scripts/scene_package_smoke.mjs && node scripts/refresh_scene_package_index_test.mjs",
    "test:app-packages": "node scripts/app_package_smoke.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint src",
    "check:bundle": "node scripts/check_bundle_budget.mjs dist",
    "check:architecture": "node scripts/check_viewer_architecture.mjs",
    "test:rosbridge:docker": "scripts/run_rosbridge_docker_test.sh",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@sparkjsdev/spark": "^2.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/three": "^0.185.1",
    "eslint": "^10.8.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.7",
    "ws": "^8.21.0"
  }
}
